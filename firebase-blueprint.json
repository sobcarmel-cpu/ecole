{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile representation in Verbe École d'art oratoire",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Public name of the orator"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Email address of the orator"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar URL"
        },
        "oratoryLevel": {
          "type": "string",
          "enum": ["debutant", "intermediaire", "avance"],
          "description": "Current declared oratory level"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation"
        }
      },
      "required": ["displayName", "email", "createdAt"]
    },
    "SpeechRecording": {
      "title": "SpeechRecording",
      "description": "Recorded speech session with vocal metrics and AI diagnosis",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the owner orator"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Title or topic of the speech"
        },
        "transcript": {
          "type": "string",
          "maxLength": 10000,
          "description": "Speech text transcript"
        },
        "durationSeconds": {
          "type": "number",
          "description": "Duration in seconds"
        },
        "wordsPerMinute": {
          "type": "number",
          "description": "Measured speech rate in WPM"
        },
        "pausesCount": {
          "type": "number",
          "description": "Detected strategic pauses"
        },
        "averageVolumeDb": {
          "type": "number",
          "description": "Average sound level in decibels"
        },
        "pitchVariation": {
          "type": "number",
          "description": "Intonation dynamic score (0-100)"
        },
        "score": {
          "type": "number",
          "description": "Overall eloquence score from Gemini"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of session"
        }
      },
      "required": ["userId", "title", "transcript", "durationSeconds", "wordsPerMinute", "createdAt"]
    },
    "CoachMessage": {
      "title": "CoachMessage",
      "description": "Saved exchange between the orator and Coach Marcus",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Owner user UID"
        },
        "topic": {
          "type": "string",
          "maxLength": 200,
          "description": "Session topic"
        },
        "lastMessage": {
          "type": "string",
          "maxLength": 2000,
          "description": "Preview of the last message"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last activity timestamp"
        }
      },
      "required": ["userId", "topic", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private profile of the authenticated student orator"
    },
    "/speeches/{speechId}": {
      "schema": { "$ref": "#/entities/SpeechRecording" },
      "description": "Recorded speech sessions with voice metrics"
    },
    "/coachSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/CoachMessage" },
      "description": "Marcus sparring sessions"
    }
  }
}
