rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('oratoryLevel' in data) || (data.oratoryLevel in ['debutant', 'intermediaire', 'avance']))
        && data.createdAt is timestamp;
    }

    function isValidSpeech(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.transcript is string && data.transcript.size() <= 10000
        && data.durationSeconds is number && data.durationSeconds >= 0
        && data.wordsPerMinute is number && data.wordsPerMinute >= 0
        && (!('pausesCount' in data) || (data.pausesCount is number && data.pausesCount >= 0))
        && (!('averageVolumeDb' in data) || (data.averageVolumeDb is number && data.averageVolumeDb >= 0))
        && (!('pitchVariation' in data) || (data.pitchVariation is number && data.pitchVariation >= 0 && data.pitchVariation <= 100))
        && (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 100))
        && data.createdAt is timestamp;
    }

    function isValidCoachSession(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.topic is string && data.topic.size() > 0 && data.topic.size() <= 200
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 2000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII protection, no list allowed
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // 2. Speech Recordings & Voice Metrics
    match /speeches/{speechId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(speechId)
        && isValidSpeech(incoming())
        && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(speechId)
        && isValidSpeech(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(speechId)
        && existing().userId == request.auth.uid;
    }

    // 3. Coach Sessions
    match /coachSessions/{sessionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sessionId)
        && isValidCoachSession(incoming())
        && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(sessionId)
        && isValidCoachSession(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(sessionId)
        && existing().userId == request.auth.uid;
    }
  }
}
